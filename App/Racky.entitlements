<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Runtime de computadores sem Docker (RackyVZ): o app hospeda as VMs (Virtualization.framework). Sem sandbox, sem perfil de
	     provisionamento: o entitlement vale com assinatura ad-hoc e com a identidade local. -->
	<key>com.apple.security.virtualization</key>
	<true/>
</dict>
</plist>
