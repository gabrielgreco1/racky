#!/usr/bin/env python3
"""`http_request` do computador (07 CS-240): roda no `work` com curl_cffi e sai pelo egress (HTTP(S)_PROXY do ambiente).

Lê UM objeto JSON do stdin e escreve UM objeto JSON no stdout. Quem chama (o app, via Engine API) registra o resultado no
reqlog `observed`; este script não grava nada e não tem token nem credencial. Corpo até 8 MiB.

Entrada: method, url, headers?, query?, body? | json? | form?, cookies?[{name,value,domain?,path?}], impersonate?,
         follow_redirects?, timeout_s?
Saída:   {status, headers:[[k,v]], final_url, body_b64, truncated, elapsed_ms} ou {error, message}
"""
import base64
import json
import os
import sys
import time

MAX_BODY = 8 * 1024 * 1024
IMPERSONATE = {"chrome": "chrome", "safari": "safari", "firefox": "firefox"}


def main() -> int:
    spec = json.load(sys.stdin)
    from curl_cffi import requests as cr

    proxy = os.environ.get("HTTPS_PROXY") or os.environ.get("https_proxy") or os.environ.get("ALL_PROXY")
    proxies = {"http": os.environ.get("HTTP_PROXY") or proxy, "https": proxy} if proxy else None
    kwargs = {
        "method": spec.get("method", "GET").upper(),
        "url": spec["url"],
        "headers": spec.get("headers") or None,
        "params": spec.get("query") or None,
        "allow_redirects": bool(spec.get("follow_redirects", True)),
        "timeout": float(spec.get("timeout_s", 30)),
        "proxies": proxies,
    }
    imp = IMPERSONATE.get(spec.get("impersonate") or "none")
    if imp:
        kwargs["impersonate"] = imp
    if spec.get("json") is not None:
        kwargs["json"] = spec["json"]
    elif spec.get("form") is not None:
        kwargs["data"] = spec["form"]
    elif spec.get("body") is not None:
        kwargs["data"] = spec["body"].encode("utf-8")
    if spec.get("cookies"):
        # Cabeçalho explícito, não o cookie jar do curl: o jar do curl descarta cookies sem domínio "de verdade" (host `origin`).
        headers = dict(kwargs["headers"] or {})
        if not any(k.lower() == "cookie" for k in headers):
            headers["Cookie"] = "; ".join(f"{c['name']}={c['value']}" for c in spec["cookies"])
        kwargs["headers"] = headers
    started = time.monotonic()
    try:
        response = cr.request(**kwargs)
    except Exception as exc:  # erro de conexão/proxy/timeout: o app classifica (blocked_by_policy, proxy_error, timeout)
        message = str(exc)
        kind = "timeout" if "timed out" in message.lower() or "timeout" in type(exc).__name__.lower() else "request_failed"
        print(json.dumps({"error": kind, "message": message[:500], "elapsed_ms": round((time.monotonic() - started) * 1000)}))
        return 0
    body = response.content or b""
    out = {
        "status": response.status_code,
        "headers": [[k, v] for k, v in response.headers.items()],
        "final_url": str(response.url),
        "body_b64": base64.b64encode(body[:MAX_BODY]).decode(),
        "truncated": len(body) > MAX_BODY,
        "elapsed_ms": round((time.monotonic() - started) * 1000),
    }
    print(json.dumps(out))
    return 0


if __name__ == "__main__":
    sys.exit(main())
