#!/usr/bin/env python3
"""Abre um pull request pelo gateway do GitHub do computador (o egress põe o token; o agente nunca o vê).

Uso: racky-pr --repo dono/repo --head feat/listings-chicago --base main --title "..." [--body-file pr.md] [--draft]
Imprime a URL do PR. Sem acesso ao GitHub nesta sessão, o gateway responde 403 com o motivo.
"""
import argparse
import json
import sys
import urllib.request

API = "http://api.github.racky"


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("--repo", required=True)
    p.add_argument("--head", required=True)
    p.add_argument("--base", default="main")
    p.add_argument("--title", required=True)
    p.add_argument("--body-file")
    p.add_argument("--draft", action="store_true")
    a = p.parse_args()
    body = open(a.body_file, encoding="utf-8").read() if a.body_file else ""
    data = json.dumps({"title": a.title, "head": a.head, "base": a.base, "body": body, "draft": a.draft}).encode()
    req = urllib.request.Request(f"{API}/repos/{a.repo}/pulls", data=data, method="POST",
                                 headers={"Content-Type": "application/json", "Accept": "application/vnd.github+json"})
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({"http": "http://127.0.0.1:3128"}))
    try:
        with opener.open(req, timeout=30) as resp:
            out = json.load(resp)
    except urllib.error.HTTPError as exc:
        print(f"racky-pr: {exc.code} {exc.read().decode(errors='replace')}", file=sys.stderr)
        return 1
    print(out.get("html_url", json.dumps(out)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
